{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(approvals.yaml)",
      "Bash(node *approve-hook.mjs*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/skills/make-slides/scripts/approve-hook.mjs\""
          }
        ]
      }
    ]
  }
}
