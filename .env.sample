# スライド用リポジトリの設定。このファイルを .env に写して書く（cp .env.sample .env）
# npm run create-slide-repo と npm run update-harness が読む。書き方の例は README「.env の書き方」
# .env は .gitignore で管理外。トークンやパスワードは書かない（GitHub へのログインは gh auth login で行う）

# ── 必須 ─────────────────────────────────────────
# 作るスライド用リポジトリ。「持ち主/リポジトリ名」で書く（private で作られる）
#   自分のアカウントに作る      SLIDE_REPO=your-name/my-slides
#   組織（Organization）に作る  SLIDE_REPO=your-org/my-slides
#   SSH で push したい          SLIDE_REPO=git@github.com:your-name/my-slides.git
#                               （URL で書くと gh を使わないので、空のリポジトリを先に作り、既定ブランチも手で develop にする）
SLIDE_REPO=your-name/my-slides

# ── 任意（空のままでよい）─────────────────────────
# 手元に clone する場所。空なら、このリポジトリの隣（../<リポジトリ名>）
#   例：SLIDE_REPO_DIR=~/work/my-slides （~/ はホームのフォルダ。このリポジトリからの相対パスも書ける）
SLIDE_REPO_DIR=

# 複製元・更新の取り込み元のハーネス。空なら GinjiHayashi/claude-code-slide-html
#   ハーネスを自分のリポジトリに複製して直しているときだけ書く：HARNESS_REPO=your-name/claude-code-slide-html
HARNESS_REPO=
